  "description": "A lightweight safety and evaluation layer for AI coding agents — Claude Code, Codex, Cursor, Copilot, and more.",
  "keywords": ["ai", "coding", "agent", "safety", "evaluation", "benchmark", "claude", "codex", "cursor", "cli", "devtools", "workflow", "repo-safety", "agentic-coding", "ai-devtools"],
  "author": "Catalayer AI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stephenywilson/RepoBlackbox.git"
  },
  "homepage": "https://github.com/stephenywilson/RepoBlackbox#readme",
  "bugs": {
    "url": "https://github.com/stephenywilson/RepoBlackbox/issues"
  },
  "bin": {
    "repoblackbox": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "chalk": "^4.1.2",
